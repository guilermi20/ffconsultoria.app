# Backend — TEAM FF | CONSULTORIA
# Copie para .env e ajuste conforme necessário.

PORT=4000
HOST=0.0.0.0

# Connection string do PostgreSQL.
# No docker-compose o host é "db"; rodando localmente use "localhost".
DATABASE_URL=postgres://teamff:teamff@localhost:5432/teamff

# Origem permitida para CORS (frontend Next.js)
CORS_ORIGIN=http://localhost:3000

# Base pública do storage (R2/S3) usada nos stubs de presigned URL do demo
PUBLIC_MEDIA_BASE_URL=https://media.teamff.dev
