# Frontend — TEAM FF | CONSULTORIA (app Next.js integrado: UI + API)
# Copie para .env.local

# Conexão do PostgreSQL (Neon / Vercel Postgres / Supabase / local).
# Use a connection string COM POOLER na Vercel (host "-pooler" no Neon).
# Ex.: postgres://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/teamff?sslmode=require
DATABASE_URL=postgres://teamff:teamff@localhost:5432/teamff

# Base pública do storage (R2/S3) usada no stub de presigned URL
PUBLIC_MEDIA_BASE_URL=https://media.teamff.dev

# (Opcional) Aponte a API para um backend externo em vez da mesma origem.
# Em deploy padrão na Vercel, NÃO defina isto — a API é servida em /api.
# NEXT_PUBLIC_API_URL=
