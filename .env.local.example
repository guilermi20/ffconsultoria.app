# Banco de dados Postgres (Neon, Supabase, Railway ou local via Docker)
DATABASE_URL=postgres://ff:ff@localhost:5432/ff_training
# Em provedores gerenciados normalmente exige SSL:
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Segredo usado para assinar o cookie de sessão do coach (troque em produção)
AUTH_SECRET=troque-este-valor-por-uma-string-longa-e-aleatoria

# URL pública da aplicação — usada para montar os links de check-in dos alunos
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- WhatsApp -------------------------------------------------------------
# manual  = gera a fila e o link wa.me para o coach enviar (padrão do Módulo 1)
# evolution = Evolution API / Z-API   |   cloud = WhatsApp Cloud API (Meta)
WHATSAPP_PROVIDER=manual
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE=

# Tamanho do pool de conexões (use 1 com o Postgres de desenvolvimento)
# DB_POOL_MAX=5
